# Copia questo file in .env.local e riempi i valori.
# .env.local non viene mai committato (vedi .gitignore).

# URL del progetto Supabase (VLTA_Database)
SUPABASE_URL=https://lzhtqdkunocvediekgal.supabase.co

# Chiave pubblica: usata SOLO per il login di /admin e per verificare i token.
# È progettata per essere pubblica, ma senza policy RLS non dà accesso ai dati.
SUPABASE_ANON_KEY=

# Chiave con privilegi totali: SOLO lato server, MAI nel client.
# Non deve comparire in nessun file dentro admin/ o index.html.
SUPABASE_SERVICE_ROLE_KEY=

# Email autorizzate ad accedere a /admin, separate da virgola.
ADMIN_EMAILS=swotstudios@gmail.com

# Resend: invio delle email di valutazione ai clienti.
# La chiave sta solo lato server, come la service role di Supabase.
RESEND_API_KEY=

# Mittente delle email. Il dominio deve essere verificato su Resend,
# altrimenti l'invio viene rifiutato.
RESEND_FROM_EMAIL=info@vendiamolatuaauto.com

# Dominio pubblico del sito, usato per costruire il link assoluto della CTA
# nelle email. Con www: il dominio nudo risponde con un redirect 308.
PUBLIC_SITE_URL=https://www.vendiamolatuaauto.com

# Secret del webhook Resend (Resend -> Webhooks -> Signing Secret).
# Serve a verificare che gli eventi arrivino davvero da Resend.
RESEND_WEBHOOK_SECRET=
